# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Environment (development/production)
ENVIRONMENT=development

# Storage path for JSON files
STORAGE_PATH=./storage

# Use polling mode (true) or webhook mode (false)
# Polling is perfect for local development - no webhook setup needed!
USE_POLLING=true

# Allowed Telegram User IDs (comma-separated, leave empty to allow all in dev mode)
# Use /myid command in the bot to get your user ID
# ALLOWED_USER_IDS=123456789,987654321

# Server port (optional, defaults to 8080)
# PORT=8080
