# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Secret key for deriving public menu ids (HMAC-SHA256). At least 32
# characters; the bot refuses to start without it. Generate with:
#   openssl rand -hex 32
# Changing it changes every menu URL.
HASH_SECRET=

# GitHub token used to commit menus to the site repository. Use a
# fine-grained token limited to that one repository with
# "Contents: Read and write" and nothing else.
GITHUB_TOKEN=

# Site repository that receives static/menus/<id>.json, as owner/name.
GITHUB_REPO=luis-serrano-l/demenu

# Public base URL of the site, used to build the menu links sent to users.
# Must be https (http is accepted for localhost only).
HUGO_BASE_URL=https://luis-serrano-l.github.io/demenu

# --- Optional ---------------------------------------------------------------

# Branch of GITHUB_REPO to commit to. Default: main
GITHUB_BRANCH=main

# Comma-separated Telegram user IDs that may publish menus. Default: none
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs that may publish, use /status and /myid,
# and receive /request_access notifications. Default: none
ADMIN_USER_IDS=

# Directory for the local copy of published menus. Default: ./data
# (compose.yaml always sets this to /data, the named volume.)
STORAGE_PATH=./data

# Port for the /health endpoint. Default: 8080
PORT=8080

# Largest accepted menu (message text or .json file), in bytes.
# Default: 262144 (256 KB)
MAX_UPLOAD_BYTES=262144

# Publishes allowed per user within PUBLISH_RATE_WINDOW. Default: 5
PUBLISH_RATE_LIMIT=5

# Length of the rate-limit window, as a Go duration (30m, 1h, 24h).
# Default: 1h
PUBLISH_RATE_WINDOW=1h
